# Environment Mode: production | development
APP_ENV=production
ENABLE_API_DOCS=false

# MySQL Database URL (Bound to 127.0.0.1:3306 only)
DATABASE_URL=mysql+aiomysql://temple_app:YOUR_SECURE_PASSWORD@127.0.0.1:3306/temple_db

# Security & Secret Keys
JWT_SECRET_KEY=YOUR_64_CHAR_RANDOM_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Domain Settings
CORS_ORIGINS=https://billing.example.com
CLOUDFLARE_TUNNEL_NAME=temple-billing-tunnel

# Default Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD

# SMTP Email Configuration (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sembukuttysastha.kovil@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=sembukuttysastha.kovil@gmail.com

# SMS Gateway Key
FAST2SMS_API_KEY=YOUR_FAST2SMS_KEY_IF_APPLICABLE
